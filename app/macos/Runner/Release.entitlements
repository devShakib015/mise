<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Deliberately not sandboxed.
	     This app runs a database server, binds a LAN port so tablets can reach
	     it, spawns that server as a child process, and opens sockets to thermal
	     printers. The sandbox blocks the middle two outright: it quarantines
	     every file a sandboxed app writes, and a quarantined binary cannot be
	     executed — stripping the attribute is itself blocked.

	     The trade is App Store distribution, which was never on the table: the
	     store does not allow a bundled server binary either. Mise ships as a
	     signed DMG from the project's own site. -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
